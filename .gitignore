# --- Secrets — never commit API keys ---
.env
.env.*
*.key

# --- Runtime data (regenerated by running the system, not source) ---
graph/kuzu_db/
db/pg_data/
*.log

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
venv/
.venv/

# --- Docker ---
*.pid

# --- Frontend (once Vue3/Quasar work starts) ---
frontend/node_modules/
frontend/dist/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
